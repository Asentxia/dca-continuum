{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "outDir": "dist",
    "rootDir": ".",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": false
  },
  "include": [
    "src/**/*.ts",
    "scheduler/**/*.ts",
    "tests/**/*.ts",
    "internal/**/*.ts"
  ]
}
