{
  "name": "asentxia-continuum",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "bash tools/run-safe-implementation.sh",
    "release-check": "python3 tools/check-release.py --enforce",
    "qualification": "bash qualification/run-first-gates.sh",
    "qualification-check": "python3 qualification/check-gates.py --enforce",
    "implementation:validate": "bash tools/run-safe-implementation.sh",
    "test:legacy-fixture": "bash tools/run-validation.sh",
    "build:backend": "tsc",
    "test:canonical": "bash tools/run-canonical-tests.sh",
    "dev:console": "bash tools/run-console.sh",
    "build:console": "bash tools/web-node22.sh build",
    "typecheck:console": "bash tools/web-node22.sh typecheck",
    "test:console": "bash tools/web-node22.sh test",
    "test:e2e:console": "node --test --test-concurrency=1 --test-reporter=tap dist/tests/console-browser.test.js",
    "build:product": "node tools/build-product.mjs",
    "scheduler:fixture": "node dist/tests/scheduler-comparison.js",
    "format": "prettier --write \"{src,scheduler,web,tests,internal}/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"{src,scheduler,web,tests,internal}/**/*.{ts,tsx,css}\""
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1150.0",
    "@runloop/api-client": "2.0.0",
    "@temporalio/activity": "1.24.0",
    "@temporalio/client": "1.24.0",
    "@temporalio/worker": "1.24.0",
    "@temporalio/workflow": "1.24.0",
    "ipaddr.js": "2.5.0",
    "jose": "6.2.12",
    "pg": "8.23.1",
    "pg-boss": "12.37.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "playwright": "1.64.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "@axe-core/playwright": "4.13.0",
    "@temporalio/testing": "1.24.0"
  },
  "workspaces": [
    "web"
  ],
  "overrides": {
    "postcss": "8.5.29"
  }
}
